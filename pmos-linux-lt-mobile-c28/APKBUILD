pkgname="linux-lt-mobile-c28"
pkgver="6.6.89"
pkgrel="5"
pkgdesc="Prebuilt Android Kernel for LT C28 (MT6765)"
url="https://kernel.org"
arch="aarch64"
_flavor="lt-mobile-c28"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="kmod"
source="kernel dtb.img modules.tar.gz"

package() {
	export INSTALL_MOD_PATH="$pkgdir/usr"
    install -Dm644 "$srcdir"/kernel "$pkgdir"/boot/vmlinuz
    install -Dm644 "$srcdir"/kernel "$pkgdir"/boot/vmlinuz-$_flavor
    install -Dm644 "$srcdir"/dtb.img "$pkgdir"/boot/dtb.img
    
    install -d "$pkgdir"/usr/share/kernel/$_flavor
    echo "$pkgver" > "$pkgdir"/usr/share/kernel/$_flavor/kernel.release
    
    # استخراج الوحدات وضمان استقرارها في المسار القياسي
    install -d "$pkgdir"/usr/lib/modules/$pkgver
    install -d "$pkgdir/usr/lib/modules"
    tar -xzf "$srcdir"/modules.tar.gz -C "$pkgdir"/usr/lib/modules/$pkgver/ --strip-components=1 || tar -xzf "$srcdir"/modules.tar.gz -C "$pkgdir"/usr/lib/modules/$pkgver/
    
    # دعم نظام المسارات المدمجة
    mkdir -p "$pkgdir"/usr/lib
    
    # تشغيل depmod لتوليد ملفات الفهرس إجبارياً
    depmod -a -b "$pkgdir" "$pkgver"
}

